{
  "name": "umzug-modern",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "next dev",
    "dev:setup": "./dev-setup.sh",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "docker:build": "docker build -t asam-abd-app .",
    "docker:run": "docker compose up -d",
    "docker:stop": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "analyze": "ANALYZE=true next build",
    "security:audit": "pnpm audit --audit-level=high",
    "prod:build": "NODE_ENV=production pnpm build",
    "prod:start": "NODE_ENV=production pnpm start"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "^6.8.2",
    "aos": "^2.3.4",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "critters": "^0.0.25",
    "date-fns": "^4.4.0",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.3",
    "next": "16.2.10",
    "nodemailer": "^9.0.3",
    "prisma": "^6.8.2",
    "react": "^19.2.7",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.82.0",
    "react-intersection-observer": "^10.1.0",
    "sharp": "^0.35.3",
    "swiper": "^14.0.6",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@next/bundle-analyzer": "^16.2.5",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@types/aos": "^3.0.7",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "8.64.0",
    "@typescript-eslint/parser": "8.64.0",
    "autoprefixer": "10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.5",
    "postcss": "8.4.31",
    "tailwindcss": "3.3.0",
    "typescript": "^5"
  }
}
